# API Gateway được Vite proxy trong môi trường phát triển.
VITE_GATEWAY_URL=http://127.0.0.1:8080

# Firebase Web Push (lấy từ Firebase Console > Project settings > Your apps).
# Bỏ trống các biến này nếu chỉ sử dụng hộp thông báo trong ứng dụng.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
