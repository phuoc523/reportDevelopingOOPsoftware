limit_req_zone $binary_remote_addr zone=mock_payment:1m rate=20r/m;
server {
    listen 7514;
    root /var/www/admin;
    location / { try_files $uri $uri/ /index.html; }
    location ^~ /api/ { proxy_pass http://api-gateway:8080; }
}
server {
    listen 7515;
    root /var/www/kiosk;
    location / { try_files $uri $uri/ /index.html; }
    location ^~ /api/ { proxy_pass http://api-gateway:8080; }
}
server {
    listen 3000;
    root /var/www/mock;
    client_max_body_size 4k;
    location / { try_files $uri $uri/ /index.html; }
    location ~ ^/api/v1/payments/public/[A-Za-z0-9_-]+$ {
        limit_except GET { deny all; }
        proxy_pass http://order-service:8083;
    }
    location ~ ^/api/v1/payments/public/[A-Za-z0-9_-]+/confirm$ {
        limit_except POST { deny all; }
        if ($http_origin != "http://127.0.0.1:17516") { return 403; }
        limit_req zone=mock_payment burst=4 nodelay;
        limit_req_status 429;
        proxy_set_header X-Payment-Callback-Token "${PAYMENT_CALLBACK_TOKEN}";
        proxy_pass http://order-service:8083;
    }
    location /api/ { return 404; }
}
