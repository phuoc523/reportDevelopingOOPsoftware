REDIS_HOST=
REDIS_PORT=
MOSQUITTO_HOST=
MOSQUITTO_PORT=
NIFI_HOST=
NIFI_PORT=
API_GATEWAY_URL=
ADMIN_WEB_URL=
KIOSK_WEB_URL=
REPORTING_SYNC_API_KEY=local-reporting-sync-key
INTERNAL_SERVICE_KEY=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTIFICATION_KAFKA_GROUP_ID=notification-service-v1
NOTIFICATION_KAFKA_RETRY_ATTEMPTS=3
NOTIFICATION_KAFKA_RETRY_BACKOFF_MS=1000
NOTIFICATION_IDENTITY_CONNECT_TIMEOUT=2s
NOTIFICATION_IDENTITY_READ_TIMEOUT=5s
NOTIFICATION_DB_CONNECTION_TIMEOUT_MS=5000
NOTIFICATION_DB_VALIDATION_TIMEOUT_MS=3000
NOTIFICATION_DB_MAX_POOL_SIZE=10
NOTIFICATION_DB_MIN_IDLE=2
NOTIFICATION_SHUTDOWN_TIMEOUT=20s
NOTIFICATION_FIREBASE_ENABLED=false
NOTIFICATION_FIREBASE_PROJECT_ID=
# Đường dẫn trên máy host, dùng với file compose bổ sung trong infra/firebase.
NOTIFICATION_FIREBASE_CREDENTIALS_FILE=
# Chỉ dùng khi credentials đã được mount sẵn vào container.
NOTIFICATION_FIREBASE_CREDENTIALS_PATH=
NOTIFICATION_FIREBASE_POLL_INTERVAL=5s
NOTIFICATION_FIREBASE_BATCH_SIZE=20
NOTIFICATION_FIREBASE_MAX_ATTEMPTS=5
NOTIFICATION_FIREBASE_INITIAL_BACKOFF=10s
NOTIFICATION_FIREBASE_DELIVERY_LEASE=5m


