@startuml order-use-case
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title ORDER SERVICE - USE CASE

actor "API consumer" as Customer
actor "Payment Provider" as Provider
actor "Nhân viên hỗ trợ" as Support
actor "Catalog Service" as Catalog
actor "Machine Service" as Machine
actor "Reporting Service" as Reporting

rectangle "Order Service" {
  usecase "Tạo / xem đơn hàng" as Order
  usecase "Tạo QR và xem payment" as Payment
  usecase "Nhận payment callback" as Callback
  usecase "Yêu cầu dispensing" as Dispense
  usecase "Xem trạng thái dispensing" as Status
  usecase "Review / reconcile giao dịch" as Review
  usecase "Lấy product-price snapshot" as ProductSnapshot
  usecase "Kiểm tra machine-slot" as SlotSnapshot
  usecase "Đồng bộ giao dịch" as Sync
}

Customer --> Order
Customer --> Payment
Customer --> Status
Provider --> Callback
Support --> Review
Catalog --> ProductSnapshot
Machine --> SlotSnapshot
Machine --> Dispense
Reporting --> Sync

note bottom of Dispense
  Machine nhận command và trả trạng thái hiện tại.
  Kết quả terminal được lấy bằng polling; không giả định callback thiết bị.
end note

@enduml
