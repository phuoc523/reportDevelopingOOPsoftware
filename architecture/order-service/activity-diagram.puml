@startuml order-activity-diagram
!theme plain
skinparam conditionStyle insidediamond
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title ORDER SERVICE - CREATE ORDER

start
:Introspect Bearer token;
if (Principal hợp lệ?) then (không)
  :Trả 401/403;
  stop
endif
:Lấy authoritative machine-slot snapshot;
if (Machine và slot khả dụng?) then (không)
  :Từ chối tạo đơn;
  stop
endif
:Lấy authoritative product-price snapshot;
if (Product available và khớp slot?) then (không)
  :Từ chối tạo đơn;
  stop
endif
:Tính line total và total amount từ snapshot;
:Lưu Order(PENDING) và OrderItem;
:Trả OrderResponse;
stop

@enduml
