@startuml order-sequence-diagram
!theme plain
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title ORDER SERVICE - PAYMENT CALLBACK VÀ DISPENSING

actor "Payment Provider" as Provider
participant PaymentController
participant PaymentService
database order_db as DB
participant DispensingService
participant "Machine Service" as Machine

Provider -> PaymentController : POST /api/v1/payments/callback\ncallback token + eventId
PaymentController -> PaymentService : processCallback(request, token)
PaymentService -> PaymentService : verify callback token
PaymentService -> DB : find callback event / payment / order
alt duplicate eventId
  PaymentService --> Provider : previous idempotent result
else invalid reference, amount or currency
  PaymentService -> DB : store failure/review where applicable
  PaymentService --> Provider : error response
else valid paid callback
  PaymentService -> DB : Payment=PAID; Order=CONFIRMED; save event
  PaymentService -> DispensingService : requestDispensing(orderId)
  DispensingService -> DB : save command(REQUESTED)
  DispensingService -> Machine : POST /api/machines/dispense-commands
  Machine --> DispensingService : ACCEPTED / PROCESSING / terminal / UNKNOWN
  DispensingService -> DB : record returned state; open review if needed
  PaymentService --> Provider : PaymentResponse
end

== Later status lookup ==
actor "API consumer" as Client
Client -> DispensingService : GET /api/v1/orders/{id}/dispensing
DispensingService -> DB : load command
alt already terminal
  DispensingService --> Client : stored result
else non-terminal
  DispensingService -> Machine : GET command result
  Machine --> DispensingService : current state
  DispensingService -> DB : update state/review
  DispensingService --> Client : DispensingResponse
end

@enduml
