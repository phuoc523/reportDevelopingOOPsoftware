@startuml identity-use-case
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title IDENTITY SERVICE - USE CASE

actor "Người dùng" as User
actor "Platform Admin" as PlatformAdmin
actor "Brand Admin" as BrandAdmin
actor "Service nội bộ" as Service

rectangle "Identity Service" {
  usecase "Đăng ký" as Register
  usecase "Đăng nhập / đăng xuất" as Login
  usecase "Xem principal hiện tại" as Me
  usecase "Quản lý tenant" as Tenant
  usecase "Quản lý tài khoản" as Account
  usecase "Gán role, grant và scope" as Authorization
  usecase "Xem audit gần đây" as Audit
  usecase "Introspect JWT" as Introspect
}

User --> Register
User --> Login
User --> Me
PlatformAdmin --> Tenant
PlatformAdmin --> Account
PlatformAdmin --> Authorization
PlatformAdmin --> Audit
BrandAdmin --> Account
BrandAdmin --> Authorization
BrandAdmin --> Tenant : own tenant
BrandAdmin --> Audit
Service --> Introspect

note bottom of Introspect
  API nội bộ: POST /internal/auth/introspect.
  Bắt buộc Bearer token và X-Internal-Service-Key.
end note

@enduml
