@startuml identity-activity-diagram
!theme plain
skinparam conditionStyle insidediamond
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title IDENTITY SERVICE - LOGIN ACTIVITY

start
:Nhận username/password;
:Tìm User;
if (User tồn tại?) then (không)
  :Ghi audit thất bại;
  :Trả 401;
  stop
endif
:So khớp BCrypt;
if (Mật khẩu hợp lệ?) then (không)
  :Ghi audit thất bại;
  :Trả 401;
  stop
endif
if (active và không locked?) then (không)
  :Ghi audit thất bại;
  :Trả 401;
  stop
endif
:Tạo JWT chứa subject, role(s), tenantId, tokenVersion;
:Ghi audit thành công;
:Trả AuthResponse;
stop

@enduml
