@startuml identity-class-diagram
!theme plain
left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 10

title IDENTITY SERVICE - DOMAIN VÀ APPLICATION API

package "Domain / RBAC" {
  class User <<Entity>> {
    - id: Long
    - username: String
    - email: String
    - password: String
    - role: Role
    - active: boolean
    - locked: boolean
    - tenantId: Long
    - tokenVersion: long
    - roles: Set<Role>
    - permissionGrants: Set<Permission>
    - locationIds: Set<Long>
    - machineIds: Set<Long>
    + revokeSessions(): void
  }
  class Tenant <<Entity>> {
    - id: Long
    - code: String
    - name: String
    - status: Status
  }
  enum Role
  enum Permission
  enum "Tenant.Status" as TenantStatus {
    ACTIVE
    SUSPENDED
  }
  class AccountPrincipal <<record>> {
    + id(): Long
    + username(): String
    + tenantId(): Long
    + roles(): Set<Role>
    + grants(): Set<Permission>
    + locationIds(): Set<Long>
    + machineIds(): Set<Long>
  }
}

package "Application" {
  class AuthService <<Service>> {
    + register(request): AuthResponse
    + login(request): AuthResponse
    + logout(): void
  }
  class JwtService <<Service>> {
    + generateToken(user: User): String
    + extractUsername(token: String): String
    + extractRole(token: String): String
    + extractTokenVersion(token: String): long
  }
  class AccessPolicy <<Component>> {
    + current(): AccountPrincipal
    + has(permission: Permission): boolean
    + platform(): boolean
    + tenant(tenantId: Long): boolean
    + scope(tenantId: Long, locationId: Long, machineId: Long): boolean
  }
  class TenantService <<Service>> {
    + all(): List<Tenant>
    + create(request): Tenant
    + platformUpdate(id: Long, request): Tenant
    + brandUpdate(request): Tenant
    + status(id: Long, status: Status): Tenant
  }
  class AuditService <<Service>> {
    + record(...): void
    + authAttempt(...): void
    + recent(tenantId: Long): List<AuditEvent>
  }
  class InternalIntrospectionController <<Controller>> {
    + introspect(serviceKey: String): AccountPrincipal
  }
}

User --> Role
User --> Permission
User ..> Tenant : tenantId reference
Tenant --> TenantStatus
AuthService --> User
AuthService --> JwtService
AuthService --> AuditService
AccessPolicy ..> AccountPrincipal
InternalIntrospectionController --> AccessPolicy

note bottom
  Chỉ liệt kê field và method quyết định hành vi.
  Getter/setter, repository và DTO phụ được lược bỏ để sơ đồ dễ đọc.
end note

@enduml
