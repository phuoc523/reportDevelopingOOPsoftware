@startuml identity-class-diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title CLASS DIAGRAM - IDENTITY SERVICE DOMAIN & ARCHITECTURE

package "com.scentstation.identity.entity" {
    class User <<Entity>> {
        - Long id
        - String username
        - String email
        - String password
        - String fullName
        - Role role
        - boolean active
        - boolean locked
        - Long tenantId
        - long tokenVersion
        - Set<Role> roles
        - Set<Permission> permissionGrants
        - Set<Long> locationIds
        + getPassword(): String
        + getRoles(): Set<Role>
        + getPermissionGrants(): Set<Permission>
    }

    enum Role <<Enumeration>> {
        PLATFORM_SUPER_ADMIN
        BRAND_ADMIN
        OPERATIONS_MANAGER
        TECHNICIAN
        INVENTORY_STAFF
        VIEWER
        CUSTOMER
        ADMIN
        STAFF
    }
}

package "com.scentstation.identity.rbac" {
    enum Permission <<Enumeration>> {
        TENANT_MANAGE
        PLATFORM_CONFIG_MANAGE
        PLATFORM_ROLE_MANAGE
        PLATFORM_AUDIT_READ
        PLATFORM_REPORT_READ
        DEVICE_ACCESS_REVOKE
        BRAND_PROFILE_READ
        BRAND_PROFILE_EDIT
        BRAND_USER_MANAGE
        BRAND_ROLE_MANAGE
        CATALOG_READ
        CATALOG_MANAGE
        CAMPAIGN_MANAGE
        LOCATION_READ
        LOCATION_MANAGE
        MACHINE_READ
        MACHINE_CONTROL
        MACHINE_CONFIGURE
        ORDER_READ
        ORDER_REVIEW
        REFUND_REQUEST
        REFUND_APPROVE
        INVENTORY_READ
        INVENTORY_MANAGE
        INVENTORY_ADJUST
        MAINTENANCE_READ
        MAINTENANCE_MANAGE
        DIAGNOSTIC_SPRAY
        ALERT_READ
        ALERT_MANAGE
        REPORT_READ
        REPORT_EXPORT
        AUDIT_READ
        NOTIFICATION_READ
        NOTIFICATION_CONFIGURE
        KIOSK_BROWSE
        KIOSK_ORDER
    }

    class AccountPrincipal <<ValueObject>> {
        - Long id
        - String username
        - Long tenantId
        - List<String> roles
        - List<String> grants
        + id(): Long
        + tenantId(): Long
        + grants(): List<String>
    }

    class AccessPolicy <<Component>> {
        + current(): AccountPrincipal
        + require(permission: Permission): AccountPrincipal
        + requireTenant(tenantId: Long): AccountPrincipal
    }
}

package "com.scentstation.identity.tenant" {
    class Tenant <<Entity>> {
        - Long id
        - String code
        - String name
        - String logoUrl
        - String description
        - String contactEmail
        - String contactPhone
        - String kioskContent
        - Status status
        + getId(): Long
        + getCode(): String
        + getStatus(): Status
    }

    enum "Tenant.Status" as TenantStatus <<Enumeration>> {
        ACTIVE
        SUSPENDED
    }

    class TenantProfile <<DTO Record>> {
        + logoUrl(): String
        + description(): String
        + contactEmail(): String
        + contactPhone(): String
        + kioskContent(): String
    }
}

package "com.scentstation.identity.audit" {
    class AuditEvent <<Entity>> {
        - Long id
        - Instant occurredAt
        - Long actorId
        - Long tenantId
        - String action
        - String targetType
        - String targetId
        - String outcome
        - String beforeState
        - String afterState
    }
}

package "com.scentstation.identity.dto" {
    class AuthResponse <<DTO Record>> {
        + token(): String
        + principal(): AccountPrincipal
    }

    class LoginRequest <<DTO Record>> {
        + username(): String
        + password(): String
    }

    class RegisterRequest <<DTO Record>> {
        + username(): String
        + email(): String
        + password(): String
        + fullName(): String
        + tenantId(): Long
    }
}

package "com.scentstation.identity.service" {
    class AuthService <<Service>> {
        - UserRepository users
        - JwtService jwtService
        - AuditService auditService
        + register(request: RegisterRequest): AuthResponse
        + login(request: LoginRequest): AuthResponse
        + logout(): void
    }

    class JwtService <<Service>> {
        - String secretKey
        - Duration tokenValidity
        + generate(user: User): String
        + parse(token: String): AccountPrincipal
    }

    class TenantService <<Service>> {
        - TenantRepository tenantRepo
        + createTenant(req: CreateTenantRequest): Tenant
        + updateProfile(id: Long, req: UpdateTenantRequest): TenantProfile
    }

    class AuditService <<Service>> {
        - AuditRepository auditRepo
        + record(actorId: Long, tenantId: Long, action: String, targetType: String, targetId: String, outcome: String): void
    }
}

package "com.scentstation.identity.controller" {
    class AuthController <<Controller>> {
        - AuthService auth
        - AccessPolicy access
        + register(r: RegisterRequest): AuthResponse
        + login(r: LoginRequest): AuthResponse
        + logout(): void
        + me(): AccountPrincipal
    }

    class InternalIntrospectionController <<Controller>> {
        - JwtService jwtService
        + introspect(bearer: String): AccountPrincipal
    }

    class TenantController <<Controller>> {
        - TenantService tenantService
        + create(req: CreateTenantRequest): Tenant
    }
}

' ================= QUAN HỆ UML VÀ BẢN SỐ =================
Tenant --> TenantStatus : "trạng thái hoạt động"
Tenant "1" ..> "0..1" TenantProfile : "cập nhật qua DTO record"
Tenant "1" o-- "0..*" User : "quản lý tài khoản thuộc tenant (Aggregation)"
User --> Role : "vai trò mặc định"
User "0..*" o-- "0..*" Role : "tập hợp roles gán thêm"
User "0..*" o-- "0..*" Permission : "tập hợp permissionGrants chi tiết"
User "1" ..> "0..*" AuditEvent : "đối tượng phát sinh nhật ký kiểm toán"

AuthService --> JwtService : "tạo và ký JWT"
AuthService --> AuditService : "ghi nhận sự kiện login/register"
AuthService ..> User : "xác thực mật khẩu BCrypt"

AuthController --> AuthService : "xử lý nghiệp vụ xác thực"
AuthController --> AccessPolicy : "soát actor hiện tại"
InternalIntrospectionController --> JwtService : "giải mã token nội bộ"
TenantController --> TenantService : "điều phối nghiệp vụ tenant"

AccessPolicy ..> AccountPrincipal : "quản lý ngữ cảnh actor"
AuthResponse *-- AccountPrincipal : "chứa thông tin principal"

@enduml
