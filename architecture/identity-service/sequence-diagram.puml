@startuml identity-sequence-diagram
!theme plain
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title IDENTITY SERVICE - LOGIN VÀ INTERNAL INTROSPECTION

actor Client
participant AuthController
participant AuthService
participant JwtService
database identity_db as DB
participant "JWT Authentication Filter" as JwtFilter
participant "InternalIntrospectionController" as Internal
participant AccessPolicy
participant "Calling service" as Caller

Client -> AuthController : POST /api/auth/login
AuthController -> AuthService : login(request)
AuthService -> DB : find user by username
alt invalid password or inactive/locked account
  AuthService --> Client : 401 Unauthorized
else valid account
  AuthService -> JwtService : generateToken(user)
  JwtService --> AuthService : JWT
  AuthService --> Client : AuthResponse
end

== Service-to-service authorization ==
Caller -> JwtFilter : POST /internal/auth/introspect\nBearer JWT + service key
JwtFilter -> JwtService : validate subject and tokenVersion
JwtFilter -> DB : load current user
JwtFilter -> Internal : authenticated request
Internal -> Internal : constant-time service-key check
alt invalid service key
  Internal --> Caller : 403 Forbidden
else valid key
  Internal -> AccessPolicy : current()
  AccessPolicy --> Internal : AccountPrincipal
  Internal --> Caller : AccountPrincipal
end

@enduml
