@startuml gateway-routing-architecture
!theme plain
left to right direction
skinparam componentStyle uml2
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 10

title API GATEWAY - ROUTING VÀ TRUST BOUNDARY

actor "API consumer" as Client
component "API Gateway :8080" as Gateway
component "TrustBoundaryFilter" as Filter

package "Downstream routes" {
  component "Identity :8081\n/auth /admin /staff /customer\n/platform /brand /audit" as Identity
  component "Catalog :8082\n/products /campaigns /catalog /pricing" as Catalog
  component "Order :8083\n/v1/orders /v1/payments" as Order
  component "Machine :8084\n/machines /alerts /locations /dispense-commands" as Machine
  component "Operation :8085\n/inventory /maintenance" as Operation
  component "Reporting :8086\n/reporting" as Reporting
}

Client --> Gateway : /api/**
Gateway --> Filter : highest precedence
Filter --> Identity
Filter --> Catalog
Filter --> Order
Filter --> Machine
Filter --> Operation
Filter --> Reporting

note bottom of Filter
  - Chặn mọi URL có segment "internal"
  - Xóa header reserved và prefix nội bộ
  - Luôn tạo X-Request-Id mới
  - Gateway chỉ route; JWT/RBAC thuộc từng service
end note

@enduml
