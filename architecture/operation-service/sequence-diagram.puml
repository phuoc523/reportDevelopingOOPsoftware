@startuml operation-sequence-diagram
!theme plain
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title OPERATION SERVICE - INSTALL BOTTLE VÀ CLOSE MAINTENANCE TICKET

actor "Inventory staff" as Staff
participant BottleInstallationController as InstallController
participant BottleInstallationService as InstallService
participant MachineSlotClient as SlotPort
database operation_db as DB

== Install bottle as-is ==
Staff -> InstallController : POST /api/inventory/installations/install
InstallController -> InstallService : installBottle(request)
InstallService -> DB : load bottle / active installation
InstallService -> SlotPort : getSlot(tenantId, machineId, slotId)
SlotPort --> InstallService : local stub snapshot in current profiles
alt invalid bottle/slot or occupied installation
  InstallService --> Staff : business error
else valid
  InstallService -> DB : save installation + bottle status + movement
  InstallService --> Staff : BottleInstallationResponse
end

note right of SlotPort
  Không có updateSlotStatus/updateCurrentBottle trong port hiện tại.
end note

== Close maintenance ticket ==
actor "Technician / manager" as Tech
participant MaintenanceTicketController as TicketController
participant MaintenanceTicketService as TicketService

Tech -> TicketController : POST /api/maintenance/tickets/{id}/close
TicketController -> TicketService : closeTicket(id, request)
TicketService -> DB : load ticket + checklist + repair logs + latest test
alt required checklist chưa hoàn tất
  TicketService --> Tech : reject
else không có repair log
  TicketService --> Tech : reject
else latest post-test chưa PASSED
  TicketService --> Tech : reject
else đủ điều kiện
  TicketService -> DB : status=COMPLETED + audit event
  TicketService --> Tech : MaintenanceTicketResponse
end

@enduml
