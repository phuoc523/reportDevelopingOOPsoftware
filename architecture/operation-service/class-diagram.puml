@startuml operation-class-diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title CLASS DIAGRAM - OPERATION SERVICE DOMAIN & ARCHITECTURE

package "com.scentstation.operation.inventory" {
    class InventoryBatch <<Entity>> {
        - Long id
        - Long tenantId
        - Long productId
        - String batchCode
        - Integer receivedQuantity
        - LocalDate receivedAt
        - LocalDate expiryDate
        - LocalDateTime createdAt
        - LocalDateTime updatedAt
        + getId(): Long
        + getBatchCode(): String
    }

    class Bottle <<Entity>> {
        - Long id
        - Long tenantId
        - Long productId
        - Long batchId
        - String bottleCode
        - BigDecimal initialQuantity
        - BigDecimal currentQuantity
        - BottleStatus status
        - LocalDateTime createdAt
        - LocalDateTime updatedAt
        + isAvailable(): boolean
        + setStatus(status: BottleStatus): void
    }

    class BottleInstallation <<Entity>> {
        - Long id
        - Long tenantId
        - Long bottleId
        - Long machineId
        - Long slotId
        - LocalDateTime installedAt
        - LocalDateTime removedAt
        - Long installedByActorId
        - Long removedByActorId
        + getBottleId(): Long
        + getSlotId(): Long
    }

    class BottleMovement <<Entity>> {
        - Long id
        - Long tenantId
        - Long bottleId
        - BottleMovementType movementType
        - String fromLocation
        - String toLocation
        - LocalDateTime timestamp
        - Long actorId
    }

    enum BottleStatus <<Enumeration>> {
        AVAILABLE
        INSTALLED
        NEARLY_EMPTY
        EMPTY
        DAMAGED
        EXPIRED
    }

    enum BottleMovementType <<Enumeration>> {
        INBOUND
        INSTALL
        REMOVE
        TRANSFER
        DISPOSAL
    }
}

package "com.scentstation.operation.maintenance" {
    class MaintenanceTicket <<Entity>> {
        - Long id
        - Long tenantId
        - Long machineId
        - Long slotId
        - Long bottleId
        - String title
        - String description
        - String category
        - MaintenanceSeverity severity
        - MaintenancePriority priority
        - MaintenanceStatus status
        - Long reportedByActorId
        - Long assignedToActorId
        - LocalDateTime dueAt
        - LocalDateTime createdAt
        - LocalDateTime updatedAt
        - LocalDateTime closedAt
        - Long locationId
        - boolean critical
        + getStatus(): MaintenanceStatus
        + setStatus(status: MaintenanceStatus): void
    }

    class MaintenanceChecklistItem <<Entity>> {
        - Long id
        - Long tenantId
        - Long ticketId
        - String itemName
        - String description
        - boolean required
        - boolean completed
        - LocalDateTime checkedAt
        - Long checkedByActorId
        + isCompleted(): boolean
    }

    class MaintenanceRepairLog <<Entity>> {
        - Long id
        - Long tenantId
        - Long ticketId
        - Long actorId
        - String actionTaken
        - String notes
        - String partsReplaced
        - LocalDateTime createdAt
    }

    class PostMaintenanceTest <<Entity>> {
        - Long id
        - Long tenantId
        - Long ticketId
        - Long machineId
        - Long requestedByActorId
        - PostMaintenanceTestStatus status
        - String sprayTelemetry
        - LocalDateTime testedAt
        + getStatus(): PostMaintenanceTestStatus
    }

    enum MaintenanceStatus <<Enumeration>> {
        OPEN
        ASSIGNED
        IN_PROGRESS
        PENDING_PARTS
        COMPLETED
        CANCELLED
    }

    enum PostMaintenanceTestStatus <<Enumeration>> {
        NOT_TESTED
        PASSED
        FAILED
    }

    enum MaintenanceSeverity <<Enumeration>> {
        LOW
        MODERATE
        CRITICAL
    }

    enum MaintenancePriority <<Enumeration>> {
        LOW
        MEDIUM
        HIGH
        URGENT
    }
}

package "com.scentstation.operation.services" {
    class BottleInstallationService <<Service>> {
        - BottleRepository bottleRepository
        - BottleInstallationRepository bottleInstallationRepository
        - BottleMovementRepository bottleMovementRepository
        - MachineSlotClient machineSlotClient
        + installBottle(req: InstallBottleRequest): BottleInstallationResponse
        + removeBottle(req: RemoveBottleRequest): BottleInstallationResponse
    }

    class MaintenanceTicketService <<Service>> {
        - MaintenanceTicketRepository maintenanceTicketRepository
        - MaintenanceChecklistRepository maintenanceChecklistRepository
        - MaintenanceRepairLogRepository maintenanceRepairLogRepository
        - PostMaintenanceTestRepository postMaintenanceTestRepository
        + createTicket(req: CreateMaintenanceTicketRequest): MaintenanceTicketResponse
        + closeTicket(ticketId: Long, req: CloseMaintenanceTicketRequest): MaintenanceTicketResponse
    }
}

package "com.scentstation.operation.inventory.integration.machine" {
    interface MachineSlotClient <<Interface>> {
        + getSlot(tenantId: String, machineId: Long, slotId: Long): MachineSlotInfo
        + updateSlotStatus(tenantId: String, machineId: Long, slotId: Long, bottleId: String): void
    }
}

' ================= QUAN HỆ UML VÀ BẢN SỐ =================
InventoryBatch "1" ..> "1..*" Bottle : "tham chiếu batch_id (ID reference)"
Bottle "1" ..> "0..*" BottleInstallation : "tham chiếu bottle_id (ID reference)"
Bottle "1" ..> "0..*" BottleMovement : "nhật ký di chuyển chai"
Bottle --> BottleStatus
BottleMovement --> BottleMovementType

MaintenanceTicket "1" ..> "0..*" MaintenanceChecklistItem : "tham chiếu ticket_id (ID reference)"
MaintenanceTicket "1" ..> "0..*" MaintenanceRepairLog : "nhật ký sửa chữa"
MaintenanceTicket "1" ..> "0..1" PostMaintenanceTest : "kiểm thử hoàn tất"
MaintenanceTicket --> MaintenanceStatus
MaintenanceTicket --> MaintenanceSeverity
MaintenanceTicket --> MaintenancePriority
PostMaintenanceTest --> PostMaintenanceTestStatus

BottleInstallationService --> Bottle : "cập nhật trạng thái INSTALLED"
BottleInstallationService --> BottleInstallation : "lưu bản ghi"
BottleInstallationService --> MachineSlotClient : "đồng bộ slot máy Kiosk"

MaintenanceTicketService --> MaintenanceTicket : "quản lý vòng đời ticket"

@enduml
