@startuml operation-activity-diagram
!theme plain
skinparam conditionStyle insidediamond
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title OPERATION SERVICE - CLOSE MAINTENANCE TICKET

start
:Tải ticket trong tenant;
if (Ticket tồn tại và có thể đóng?) then (không)
  :Từ chối yêu cầu;
  stop
endif
:Kiểm tra required checklist;
if (Còn item chưa hoàn tất?) then (có)
  :Từ chối yêu cầu;
  stop
endif
if (Có repair log?) then (không)
  :Từ chối yêu cầu;
  stop
endif
:Lấy post-maintenance test mới nhất;
if (Status = PASSED?) then (không)
  :Từ chối yêu cầu;
  stop
endif
:Cập nhật ticket COMPLETED;
:Ghi maintenance audit event;
:Trả response;
stop

@enduml
