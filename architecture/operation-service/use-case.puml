@startuml operation-use-case
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title OPERATION SERVICE - USE CASE

actor "Nhân viên kho" as InventoryStaff
actor "Kỹ thuật viên" as Technician
actor "Quản lý vận hành" as Manager
actor "Machine Service" as Machine
actor "Machine slot adapter\n<<future extension>>" as SlotAdapter

rectangle "Operation Service" {
  usecase "Quản lý batch và bottle" as Inventory
  usecase "Install / remove / replace bottle" as Installation
  usecase "Refill / adjustment / consumption" as Movement
  usecase "Reconcile sensor và ước tính sprays" as Reconcile
  usecase "Xem inventory audit" as Audit
  usecase "Quản lý maintenance ticket" as Ticket
  usecase "Assignment / checklist / repair log" as Work
  usecase "Post-maintenance test" as Test
  usecase "Đóng / mở lại ticket" as Close
  usecase "Nhận critical alert" as CriticalAlert
}

InventoryStaff --> Inventory
InventoryStaff --> Installation
InventoryStaff --> Movement
InventoryStaff --> Reconcile
Manager --> Audit
Manager --> Ticket
Technician --> Work
Technician --> Test
Manager --> Close
Machine --> CriticalAlert
SlotAdapter --> Installation

note bottom of SlotAdapter
  Source hiện dùng LocalMachineSlotClient cho local/test/docker-local.
  Chưa có production HTTP adapter và chưa update slot ngược sang Machine.
end note

@enduml
