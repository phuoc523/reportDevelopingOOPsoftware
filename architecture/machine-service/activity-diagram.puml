@startuml machine-activity-diagram
!theme plain
skinparam conditionStyle insidediamond
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title MACHINE SERVICE - CREATE DISPENSE COMMAND

start
:Nhận request và service key;
if (Service key hợp lệ?) then (không)
  :Trả 401;
  stop
endif
if (commandId đã tồn tại?) then (có)
  :Trả command hiện có;
  stop
endif
:Kiểm tra machine và slot availability;
if (Khả dụng?) then (không)
  :Trả business error;
  stop
endif
:Lưu MachineCommand trạng thái ACCEPTED;
:Trả 202 ACCEPTED;
stop

legend bottom
  Hoạt động kết thúc ở ACCEPTED vì device-result adapter chưa được triển khai.
endlegend

@enduml
