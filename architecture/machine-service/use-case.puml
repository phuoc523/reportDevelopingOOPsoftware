@startuml machine-use-case
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title MACHINE SERVICE - USE CASE

actor "Quản lý vận hành" as Operator
actor "Order Service" as Order
actor "Operation Service" as Operation
actor "Device adapter\n<<future extension>>" as Device

rectangle "Machine Service" {
  usecase "Quản lý location và machine" as Machine
  usecase "Cấu hình slot" as Slot
  usecase "Xem availability/history" as Availability
  usecase "Quản lý cảnh báo" as Alert
  usecase "Nhận lệnh dispensing" as Submit
  usecase "Tra cứu trạng thái command" as Result
  usecase "ACK / hoàn tất command" as Complete
  usecase "Chuyển critical alert" as Handoff
}

Operator --> Machine
Operator --> Slot
Operator --> Availability
Operator --> Alert
Order --> Submit
Order --> Result
Device --> Complete
Operation --> Handoff

note bottom of Complete
  Domain transition đã có, nhưng chưa có inbound device adapter.
  Use case này là cổng mở rộng, không phải tính năng đã hoàn tất.
end note

@enduml
