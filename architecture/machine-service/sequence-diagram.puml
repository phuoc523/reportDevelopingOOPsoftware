@startuml machine-sequence-diagram
!theme plain
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title MACHINE SERVICE - COMMAND ACCEPTANCE VÀ RESULT LOOKUP AS-IS

participant "Order Service" as Order
participant DispenseCommandController as Controller
participant InternalServiceKeyVerifier as Key
participant DispenseCommandService as Service
participant AvailabilityService as Availability
database machine_db as DB
participant "DeviceResultPort\n<<future extension>>" as Device #EAF2F8

Order -> Controller : POST /api/machines/dispense-commands
Controller -> Key : verify(serviceKey)
alt invalid service key
  Controller --> Order : 401 Unauthorized
else valid key
  Controller -> Service : create(request)
  Service -> DB : find command by commandId
  alt command đã tồn tại
    Service --> Order : existing response (idempotent)
  else command mới
    Service -> Availability : validate machine and slot
    alt không khả dụng
      Service --> Order : business error
    else khả dụng
      Service -> DB : save MachineCommand(ACCEPTED)
      Service --> Order : 202 ACCEPTED
    end
  end
end

Order -> Controller : GET /api/machines/dispense-commands/{commandId}
Controller -> Service : get(commandId, tenantId)
Service -> DB : find command
Service --> Order : current status

note over DB,Device
  Chưa có adapter nhận ACK/result từ thiết bị.
  Không vẽ pump, relay hoặc sensor như implementation hiện tại.
end note

@enduml
