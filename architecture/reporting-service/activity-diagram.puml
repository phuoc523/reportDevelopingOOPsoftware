@startuml reporting-activity-diagram
!theme plain
skinparam conditionStyle insidediamond
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title REPORTING SERVICE - IDEMPOTENT TRANSACTION SYNC

start
:Nhận TransactionSyncRequest và internal API key;
if (API key hợp lệ?) then (không)
  :Trả 401;
  stop
endif
:Validate reference, amount, currency, status và timestamps;
if (Payload hợp lệ?) then (không)
  :Trả validation error;
  stop
endif
:Lock/find transaction theo reference;
if (Đã tồn tại?) then (có)
  :Cập nhật snapshot fields cho phép;
else (không)
  :Tạo Transaction mới;
endif
:Lưu transaction;
:Trả TransactionResponse;
stop

@enduml
