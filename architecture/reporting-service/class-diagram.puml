@startuml reporting-class-diagram
!theme plain
left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 10

title REPORTING SERVICE - DOMAIN, AGGREGATION VÀ CLIENTS

package "Domain / DTO" {
  class Transaction <<Entity>> {
    - id: Long
    - reference: String
    - orderId: String
    - amount: BigDecimal
    - currency: String
    - status: String
    - createdAt: LocalDateTime
    - paidAt: LocalDateTime
  }
  enum ReportPeriod {
    DAY
    WEEK
    MONTH
    CUSTOM
  }
  class TransactionSyncRequest <<record>>
  class DashboardResponse <<record>> {
    + transactions(): TransactionSummaryResponse
    + machines(): MachineStatusSummary
    + alerts(): AlertStatusSummary
    + inventory(): InventoryStatusSummary
    + upstream(): Map<String,String>
    + operations(): OperationReportResponse
    + access(): ReportAccess
  }
}

package "Application" {
  class TransactionService <<Service>> {
    + createTransaction(request): TransactionResponse
    + syncTransaction(request): TransactionResponse
  }
  class TransactionQueryService <<Service>> {
    + search(filter, pageable, refundsOnly): Page<TransactionResponse>
    + findById(id: Long): TransactionResponse
    + findByReference(reference: String): TransactionResponse
  }
  class DashboardAggregationService <<Service>> {
    + getDashboard(tenantId: String, period: ReportPeriod): DashboardResponse
    + getDashboard(tenantId: String, period: ReportPeriod, includePlatform: boolean): DashboardResponse
  }
  class ExcelExportService <<Service>> {
    + exportTransactions(filter): byte[]
    + exportRevenue(start: LocalDate, end: LocalDate): byte[]
  }
  class OrderPaymentSyncService <<Service>> {
    + syncFromOrder(reference: String): TransactionResponse
  }
}

package "HTTP clients" {
  class OrderPaymentClient
  class MachineSnapshotClient
  class OperationInventoryClient
}

TransactionService --> Transaction
TransactionQueryService --> Transaction
DashboardAggregationService --> MachineSnapshotClient
DashboardAggregationService --> OperationInventoryClient
ExcelExportService --> TransactionQueryService
OrderPaymentSyncService --> OrderPaymentClient
OrderPaymentSyncService --> TransactionService

note bottom of Transaction
  Entity không lưu tenantId/machineId/productId.
  Dữ liệu vận hành dashboard được đọc từ upstream services.
end note

@enduml
