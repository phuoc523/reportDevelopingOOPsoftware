@startuml reporting-sequence-diagram
!theme plain
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title REPORTING SERVICE - TRANSACTION SYNC VÀ DASHBOARD AGGREGATION

participant "Order Service" as Order
participant TransactionSyncController as SyncController
participant InternalApiKeyVerifier as Key
participant TransactionService as TransactionService
database reporting_db as DB

Order -> SyncController : POST /api/reporting/internal/transactions/sync\nX-Internal-Api-Key
SyncController -> Key : verify(key)
alt key không hợp lệ
  SyncController --> Order : 401 Unauthorized
else hợp lệ
  SyncController -> TransactionService : syncTransaction(request)
  TransactionService -> DB : lock/find by reference
  alt transaction chưa tồn tại
    TransactionService -> DB : insert transaction
  else transaction đã tồn tại
    TransactionService -> DB : update mutable snapshot fields
  end
  TransactionService --> Order : TransactionResponse
end

== Dashboard ==
actor Viewer
participant DashboardController
participant DashboardAggregationService as Dashboard
participant MachineSnapshotClient as Machine
participant OperationInventoryClient as Operation

Viewer -> DashboardController : GET /api/reporting/dashboard
DashboardController -> Dashboard : getDashboard(tenantId, period)
Dashboard -> DB : aggregate local transaction data
Dashboard -> Machine : list machines/locations/alerts
Machine --> Dashboard : snapshots or upstream error
Dashboard -> Operation : list inventory/maintenance snapshots
Operation --> Dashboard : snapshots or upstream error
Dashboard --> Viewer : DashboardResponse

@enduml
