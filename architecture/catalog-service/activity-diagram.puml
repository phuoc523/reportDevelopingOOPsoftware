@startuml catalog-activity-diagram
!theme plain
skinparam conditionStyle insidediamond
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title CATALOG SERVICE - TÍNH GIÁ HIỆU LỰC

start
:Nhận tenantId và productId;
:Tải Product trong tenant;
if (Product tồn tại?) then (không)
  :Trả 404;
  stop
endif
:Tìm campaign active trong khoảng thời gian hiện tại;
if (Có campaign phù hợp?) then (không)
  :effectivePrice = defaultPrice;
else (có)
  if (PERCENTAGE?) then (có)
    :Trừ phần trăm giảm giá;
  else (FIXED_AMOUNT)
    :Trừ số tiền cố định;
  endif
  :Không cho giá nhỏ hơn 0;
endif
:Trả EffectivePriceResponse;
stop

@enduml
