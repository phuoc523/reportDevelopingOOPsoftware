@startuml catalog-class-diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title CLASS DIAGRAM - CATALOG SERVICE DOMAIN & ARCHITECTURE

package "com.scentstation.catalog.enums" {
    enum DiscountType <<Enumeration>> {
        PERCENTAGE
        FIXED_AMOUNT
    }
}

package "com.scentstation.catalog.entity" {
    class Product <<Entity>> {
        - Long id
        - Long tenantId
        - String name
        - String description
        - String fragranceNotes
        - String imageUrl
        - BigDecimal defaultPrice
        - Boolean available
        - LocalDateTime createdAt
        - LocalDateTime updatedAt
        + getId(): Long
        + getTenantId(): Long
        + getDefaultPrice(): BigDecimal
        + getAvailable(): Boolean
    }

    class Campaign <<Entity>> {
        - Long id
        - Long tenantId
        - Long productId
        - String name
        - DiscountType discountType
        - BigDecimal discountValue
        - LocalDateTime startAt
        - LocalDateTime endAt
        - Boolean active
        - LocalDateTime createdAt
        - LocalDateTime updatedAt
        + getProductId(): Long
        + getDiscountType(): DiscountType
        + getDiscountValue(): BigDecimal
    }
}

package "com.scentstation.catalog.dto.response" {
    class ProductResponse <<DTO Record>> {
        + id(): Long
        + tenantId(): Long
        + name(): String
        + defaultPrice(): BigDecimal
        + available(): Boolean
        + fragranceNotes(): String
    }

    class EffectivePriceResponse <<DTO Record>> {
        + productId(): Long
        + defaultPrice(): BigDecimal
        + effectivePrice(): BigDecimal
        + campaignId(): Long
        + discountAmount(): BigDecimal
    }

    class OrderProductSnapshotResponse <<DTO Record>> {
        + productId(): Long
        + tenantId(): Long
        + name(): String
        + available(): Boolean
        + unitPrice(): BigDecimal
        + campaignId(): Long
    }
}

package "com.scentstation.catalog.service" {
    class ProductService <<Service>> {
        - ProductRepository productRepository
        + createProduct(req: CreateProductRequest): ProductResponse
        + getProduct(id: Long): ProductResponse
        + search(criteria: ProductSearchCriteria): List<ProductResponse>
        + updateAvailability(id: Long, available: Boolean): ProductResponse
    }

    class CampaignService <<Service>> {
        - CampaignRepository campaignRepository
        + createCampaign(req: CreateCampaignRequest): CampaignResponse
        + getActiveCampaigns(tenantId: Long): List<Campaign>
    }

    class PromotionalPricingService <<Service>> {
        - ProductRepository productRepository
        - CampaignRepository campaignRepository
        + calculateEffectivePrice(productId: Long): EffectivePriceResponse
        + getInternalEffectivePrice(product: Product): EffectivePriceResponse
    }

    class ProductMachineAvailabilityService <<Service>> {
        - MachineAvailabilityClient machineClient
        + getProductAvailabilityOnMachines(productId: Long): ProductMachineAvailabilityResponse
    }
}

package "com.scentstation.catalog.controller" {
    class ProductController <<Controller>> {
        - ProductService productService
        + list(): List<ProductResponse>
        + get(id: Long): ProductResponse
        + create(req: CreateProductRequest): ProductResponse
    }

    class PromotionalPricingController <<Controller>> {
        - PromotionalPricingService pricingService
        + getEffectivePrice(productId: Long): EffectivePriceResponse
    }

    class InternalOrderProductController <<Controller>> {
        - ProductRepository products
        - PromotionalPricingService pricing
        - InternalServiceKeyVerifier keys
        + get(productId: Long, tenantId: Long, key: String): OrderProductSnapshotResponse
    }
}

package "com.scentstation.catalog.integration.machine" {
    interface MachineAvailabilityClient <<Interface>> {
        + getAvailability(productId: Long): MachineAvailabilityInfo
    }
}

' ================= QUAN HỆ UML VÀ BẢN SỐ =================
Campaign --> DiscountType : "loại chiết khấu áp dụng"
Product "1" ..> "0..*" Campaign : "sản phẩm áp dụng chương trình ưu đãi"

ProductService --> Product : "CRUD thực thể"
CampaignService --> Campaign : "CRUD thực thể"
PromotionalPricingService --> Product : "truy vấn defaultPrice"
PromotionalPricingService --> Campaign : "tính toán giảm giá"
PromotionalPricingService ..> EffectivePriceResponse : "sinh dữ liệu giá"
PromotionalPricingService ..> OrderProductSnapshotResponse : "sinh snapshot phục vụ đơn hàng"

ProductController --> ProductService : "điều phối request sản phẩm"
PromotionalPricingController --> PromotionalPricingService : "tra cứu giá hiệu lực"
InternalOrderProductController --> PromotionalPricingService : "tạo authoritative snapshot"

ProductMachineAvailabilityService --> MachineAvailabilityClient : "truy vấn máy chứa sản phẩm"

@enduml
