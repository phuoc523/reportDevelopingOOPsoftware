@startuml catalog-use-case
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title CATALOG SERVICE - USE CASE

actor "API consumer" as Consumer
actor "Brand Admin" as Admin
actor "Order Service" as Order
actor "Machine availability adapter\n<<future extension>>" as MachineAdapter

rectangle "Catalog Service" {
  usecase "Xem / tìm sản phẩm" as Browse
  usecase "Quản lý sản phẩm" as Product
  usecase "Quản lý chiến dịch" as Campaign
  usecase "Tính giá hiệu lực" as Pricing
  usecase "Lấy product-price snapshot" as Snapshot
  usecase "Kiểm tra sản phẩm trên máy" as Availability
}

Consumer --> Browse
Consumer --> Pricing
Admin --> Product
Admin --> Campaign
Order --> Snapshot
MachineAdapter --> Availability

note bottom of Availability
  Port đã có nhưng source hiện chỉ có local/test fail-closed adapter.
  Không giả định HTTP contract tương lai.
end note

@enduml
