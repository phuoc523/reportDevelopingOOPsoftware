@startuml catalog-sequence-diagram
!theme plain
autonumber
skinparam responseMessageBelowArrow true
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title CATALOG SERVICE - AUTHORITATIVE PRODUCT/PRICE SNAPSHOT

participant "Order Service" as Order
participant InternalOrderProductController as Controller
participant InternalServiceKeyVerifier as KeyVerifier
database catalog_db as DB
participant PromotionalPricingService as Pricing

Order -> Controller : GET /internal/catalog/order-products/{productId}\n?tenantId=... + service key
Controller -> KeyVerifier : verify(key)
alt key không hợp lệ
  KeyVerifier --> Order : 401 Unauthorized
else key hợp lệ
  Controller -> DB : findByIdAndTenantId(productId, tenantId)
  alt không tìm thấy
    Controller --> Order : 404 Not Found
  else tìm thấy
    Controller -> Pricing : getInternalEffectivePrice(product)
    Pricing -> DB : find active campaigns at current time
    Pricing --> Controller : EffectivePriceResponse
    Controller --> Order : OrderProductSnapshotResponse
  end
end

@enduml
