@startuml system-use-case
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title SCENTSTATION - USE CASE TOÀN HỆ THỐNG

actor "API consumer\nFrontend/Kiosk tương lai" as Customer
actor "Platform Admin" as PlatformAdmin
actor "Brand Admin" as BrandAdmin
actor "Nhân viên vận hành" as Operator
actor "Kỹ thuật viên" as Technician
actor "Payment Provider" as Provider
actor "Service nội bộ" as InternalService

rectangle ScentStation {
  usecase "Đăng ký / đăng nhập" as UCAuth
  usecase "Quản lý tenant và tài khoản" as UCIam
  usecase "Quản lý sản phẩm và chiến dịch" as UCCatalog
  usecase "Tạo và theo dõi đơn hàng" as UCOrder
  usecase "Thanh toán đơn hàng" as UCPayment
  usecase "Quản lý máy, slot và cảnh báo" as UCMachine
  usecase "Quản lý kho và chai hương" as UCInventory
  usecase "Bảo trì máy" as UCMaintenance
  usecase "Xem dashboard / xuất báo cáo" as UCReporting
  usecase "Xác thực principal nội bộ" as UCIntrospect
}

Customer --> UCAuth
Customer --> UCOrder
Customer --> UCPayment
PlatformAdmin --> UCIam
BrandAdmin --> UCIam
BrandAdmin --> UCCatalog
BrandAdmin --> UCReporting
Operator --> UCMachine
Operator --> UCInventory
Operator --> UCReporting
Technician --> UCMaintenance
Provider --> UCPayment
InternalService --> UCIntrospect

note bottom of Customer
  Đây là actor API logic. Frontend chưa nằm trong repository
  và không được xem là một component đã triển khai.
end note

@enduml
